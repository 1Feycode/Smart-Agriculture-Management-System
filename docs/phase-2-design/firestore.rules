rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Authentication and role helpers use only server-issued token claims.
    function signedIn() { return request.auth != null; }
    function hasRole(roleName) { return signedIn() && request.auth.token.role == roleName; }
    function farmer() { return hasRole('farmer'); }
    function expert() { return hasRole('expert'); }
    function dataManager() { return hasRole('dataManager'); }
    function admin() { return hasRole('admin'); }
    // Prevent clients from adding undeclared, privilege-bearing fields.
    function onlyFields(fields) { return request.resource.data.keys().hasOnly(fields); }
    function validText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }
    function serverCreated() { return request.resource.data.createdAt == request.time; }
    // Verify that linked farm and soil-test records belong to the same farmer.
    function ownedFarm(farmId, uid) {
      return exists(/databases/$(database)/documents/farms/$(farmId))
        && get(/databases/$(database)/documents/farms/$(farmId)).data.ownerUid == uid;
    }
    // Recommendations may reference only a published active crop.
    function activeCrop(cropId) {
      let path = /databases/$(database)/documents/crops/$(cropId);
      return exists(path)
        && get(path).data.status == 'active'
        && get(path).data.isPublic == true
        && get(path).data.reviewStatus == 'approved';
    }
    function ownedSoilTest(testId, farmId, uid) {
      let path = /databases/$(database)/documents/soilTests/$(testId);
      return exists(path)
        && get(path).data.ownerUid == uid
        && get(path).data.farmId == farmId;
    }
    function validSoilTestLink(data, uid) {
      return !data.keys().hasAny(['soilTestId'])
        || data.soilTestId == null
        || ownedSoilTest(data.soilTestId, data.farmId, uid);
    }
    // Answers inherit the private access boundary of their parent question.
    function canReadQuestion(questionId) {
      let path = /databases/$(database)/documents/questions/$(questionId);
      return exists(path) && (
        admin()
        || get(path).data.ownerUid == request.auth.uid
        || (expert() && (
          get(path).data.assignedExpertUid == request.auth.uid
          || get(path).data.status == 'submitted'
          || get(path).data.status == 'underReview'
        ))
      );
    }

    // Profiles are private; owners edit non-role fields; admins can list profiles.
    // Role/status changes and physical deletion are intentionally denied to clients.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || admin());
      allow list: if admin();
      allow create: if farmer() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'farmer'
        && request.resource.data.status == 'active'
        && onlyFields(['uid', 'displayName', 'email', 'role', 'status', 'location', 'createdAt', 'updatedAt'])
        && validText(request.resource.data.displayName, 120)
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && serverCreated();
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'location', 'updatedAt'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow update: if admin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'location', 'updatedAt'])
        && request.resource.data.role == resource.data.role
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Farmers can manage only their own farms; admins can inspect/update; no hard delete.
    match /farms/{farmId} {
      allow get, list: if signedIn() && (resource.data.ownerUid == request.auth.uid || admin());
      allow create: if farmer() && request.resource.data.ownerUid == request.auth.uid
        && onlyFields(['ownerUid', 'name', 'location', 'size', 'sizeUnit', 'cropIds', 'activitySummary', 'status', 'createdAt', 'updatedAt'])
        && validText(request.resource.data.name, 120)
        && (request.resource.data.size is int || request.resource.data.size is float)
        && request.resource.data.size > 0
        && request.resource.data.status == 'active' && serverCreated();
      allow update: if farmer() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'location', 'size', 'sizeUnit', 'cropIds', 'activitySummary', 'status', 'updatedAt'])
        && (request.resource.data.size is int || request.resource.data.size is float)
        && request.resource.data.size > 0
        && request.resource.data.updatedAt == request.time;
      allow update: if admin() && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Only public/active/approved crops are guest-readable; admins curate/archive.
    match /crops/{cropId} {
      allow get, list: if admin() || (resource.data.isPublic == true
        && resource.data.status == 'active' && resource.data.reviewStatus == 'approved');
      allow create: if admin() && onlyFields(['name', 'categoryId', 'description', 'soilGuidance', 'plantingSeason', 'waterGuidance', 'growthDuration', 'harvestPeriod', 'source', 'reviewStatus', 'isPublic', 'status', 'createdAt', 'updatedAt', 'updatedByUid']) && serverCreated();
      allow update: if admin() && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Active categories are public; only admins create/update them.
    match /cropCategories/{categoryId} {
      allow get, list: if admin() || resource.data.status == 'active';
      allow create: if admin() && serverCreated();
      allow update: if admin() && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Farmers own soil records; assigned experts review; admins assign reviewers.
    // Original farmer ownership and farm linkage are immutable; no hard delete.
    match /soilTests/{soilTestId} {
      allow get, list: if signedIn() && (admin() || resource.data.ownerUid == request.auth.uid
        || (expert() && resource.data.assignedExpertUid == request.auth.uid));
      allow create: if farmer() && request.resource.data.ownerUid == request.auth.uid
        && ownedFarm(request.resource.data.farmId, request.auth.uid)
        && onlyFields(['ownerUid', 'farmId', 'testDate', 'sourceType', 'sourceName', 'ph', 'nutrients', 'texture', 'soilType', 'verificationStatus', 'createdAt', 'updatedAt'])
        && request.resource.data.verificationStatus == 'unverified' && serverCreated();
      allow update: if farmer() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.farmId == resource.data.farmId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['testDate', 'sourceType', 'sourceName', 'ph', 'nutrients', 'texture', 'soilType', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow update: if expert() && resource.data.assignedExpertUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificationStatus', 'reviewNotes', 'updatedAt'])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.farmId == resource.data.farmId
        && request.resource.data.updatedAt == request.time;
      allow update: if admin() && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.farmId == resource.data.farmId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assignedExpertUid', 'verificationStatus', 'reviewNotes', 'updatedAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Public readers see approved active fertilizer content; only admins curate it.
    match /fertilizers/{fertilizerId} {
      allow get, list: if admin() || (resource.data.status == 'active' && resource.data.reviewStatus == 'approved');
      allow create: if admin() && serverCreated();
      allow update: if admin() && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Draft fertilizer rules remain private; admins own approval and publication.
    match /fertilizerRules/{ruleId} {
      allow get, list: if admin() || (resource.data.status == 'approved' && resource.data.isPublic == true);
      allow create: if admin() && request.resource.data.status == 'draft' && serverCreated();
      allow update: if admin() && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Farmers create their own requests; experts review permitted work.
    // Result/rate changes are reserved for a separately validated trusted workflow.
    match /recommendations/{recommendationId} {
      allow get, list: if signedIn() && (admin() || resource.data.ownerUid == request.auth.uid
        || (expert() && (resource.data.assignedExpertUid == request.auth.uid
          || resource.data.status == 'submitted' || resource.data.status == 'underReview')));
      allow create: if farmer() && request.resource.data.ownerUid == request.auth.uid
        && ownedFarm(request.resource.data.farmId, request.auth.uid)
        && activeCrop(request.resource.data.cropId)
        && validSoilTestLink(request.resource.data, request.auth.uid)
        && request.resource.data.status == 'submitted'
        && onlyFields(['ownerUid', 'farmId', 'cropId', 'soilTestId', 'status', 'inputSnapshot', 'ruleId', 'ruleVersion', 'result', 'assumptions', 'sourceIds', 'assignedExpertUid', 'review', 'createdAt', 'updatedAt'])
        && request.resource.data.ruleId == null
        && request.resource.data.ruleVersion == null
        && request.resource.data.result == null
        && request.resource.data.assignedExpertUid == null
        && request.resource.data.review == null
        && serverCreated();
      allow update: if expert()
        && (resource.data.assignedExpertUid == request.auth.uid
          || resource.data.status == 'submitted' || resource.data.status == 'underReview')
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.farmId == resource.data.farmId
        && request.resource.data.cropId == resource.data.cropId
        && request.resource.data.inputSnapshot == resource.data.inputSnapshot
        && request.resource.data.result == resource.data.result
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'review', 'updatedAt'])
        && request.resource.data.status in ['underReview', 'needsInformation', 'expertReviewed', 'rejected']
        && request.resource.data.updatedAt == request.time;
      allow update: if admin() && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Questions are private to the owner, permitted experts and administrators.
    match /questions/{questionId} {
      allow get, list: if signedIn() && (admin() || resource.data.ownerUid == request.auth.uid
        || (expert() && (resource.data.assignedExpertUid == request.auth.uid
          || resource.data.status == 'submitted' || resource.data.status == 'underReview')));
      allow create: if farmer() && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && onlyFields(['ownerUid', 'title', 'description', 'category', 'status', 'assignedExpertUid', 'imagePaths', 'createdAt', 'updatedAt'])
        && validText(request.resource.data.title, 160)
        && validText(request.resource.data.description, 10000)
        && request.resource.data.assignedExpertUid == null
        && serverCreated();
      allow update: if expert()
        && (resource.data.assignedExpertUid == request.auth.uid
          || resource.data.status == 'submitted' || resource.data.status == 'underReview')
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['underReview', 'needsInformation', 'answered']
        && request.resource.data.updatedAt == request.time;
      allow update: if admin() && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Answers are append-only and readable only if the caller can read the parent.
    match /answers/{answerId} {
      allow get, list: if signedIn() && canReadQuestion(resource.data.questionId);
      allow create: if expert()
        && exists(/databases/$(database)/documents/questions/$(request.resource.data.questionId))
        && (get(/databases/$(database)/documents/questions/$(request.resource.data.questionId)).data.assignedExpertUid == request.auth.uid
          || get(/databases/$(database)/documents/questions/$(request.resource.data.questionId)).data.status == 'submitted'
          || get(/databases/$(database)/documents/questions/$(request.resource.data.questionId)).data.status == 'underReview')
        && request.resource.data.expertUid == request.auth.uid
        && onlyFields(['questionId', 'expertUid', 'body', 'status', 'createdAt'])
        && validText(request.resource.data.body, 10000) && serverCreated();
      allow update, delete: if false;
    }

    // Active markets are public; data managers/admins maintain, but cannot hard-delete.
    match /markets/{marketId} {
      allow get, list: if admin() || dataManager() || resource.data.status == 'active';
      allow create: if (admin() || dataManager()) && serverCreated();
      allow update: if (admin() || dataManager())
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Active products are public; data managers/admins maintain, but cannot hard-delete.
    match /products/{productId} {
      allow get, list: if admin() || dataManager() || resource.data.status == 'active';
      allow create: if (admin() || dataManager()) && serverCreated();
      allow update: if (admin() || dataManager())
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    // Only verified public prices are guest-readable. Corrections append; history remains.
    match /marketPrices/{priceId} {
      allow get, list: if admin() || dataManager()
        || (resource.data.verificationStatus == 'verified' && resource.data.isPublic == true);
      allow create: if (admin() || dataManager())
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.verificationStatus == 'unverified'
        && request.resource.data.verifiedByUid == null
        && request.resource.data.verifiedAt == null
        && request.resource.data.isPublic == false
        && onlyFields(['productId', 'marketId', 'productNameSnapshot', 'marketNameSnapshot', 'amount', 'currency', 'unit', 'observedAt', 'source', 'sourceRef', 'verificationStatus', 'verifiedByUid', 'verifiedAt', 'supersedesId', 'correctionReason', 'createdAt', 'createdByUid', 'isPublic'])
        && (request.resource.data.amount is int || request.resource.data.amount is float)
        && request.resource.data.amount > 0
        && serverCreated();
      allow update: if (admin() || dataManager())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verificationStatus', 'verifiedByUid', 'verifiedAt', 'isPublic'])
        && resource.data.createdByUid != request.auth.uid
        && resource.data.verificationStatus == 'unverified'
        && request.resource.data.verificationStatus in ['verified', 'rejected']
        && (request.resource.data.verificationStatus == 'verified' || request.resource.data.isPublic == false)
        && request.resource.data.amount == resource.data.amount
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.marketId == resource.data.marketId
        && request.resource.data.source == resource.data.source
        && request.resource.data.observedAt == resource.data.observedAt
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.verifiedByUid == request.auth.uid
        && request.resource.data.verifiedAt == request.time;
      allow update: if admin()
        && resource.data.verificationStatus == 'verified'
        && request.resource.data.isPublic == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isPublic']);
      allow delete: if false;
    }

    // Trusted functions create notifications; recipients may mark their own as read.
    match /notifications/{notificationId} {
      allow get, list: if signedIn() && (resource.data.recipientUid == request.auth.uid || admin());
      allow create, delete: if false;
      allow update: if signedIn() && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
        && resource.data.readAt == null
        && request.resource.data.readAt == request.time;
    }
    // Audit history is admin-readable and all client writes are denied.
    match /activityLogs/{logId} {
      allow get, list: if admin();
      allow create, update, delete: if false;
    }
    // Cache writes are reserved for the trusted weather adapter.
    match /weatherCache/{cacheId} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;
    }
    // Settings are admin-only; deleting a setting requires a controlled migration.
    match /appSettings/{settingId} {
      allow get, list: if admin();
      allow create, update: if admin();
      allow delete: if false;
    }
    // Unknown collections and paths fail closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
