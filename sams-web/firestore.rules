rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function validDisplayName(value) {
      return value is string && value.size() > 0 && value.size() <= 120;
    }

    match /users/{uid} {
      allow get: if signedIn()
        && request.auth.uid == uid
        && (!exists(/databases/$(database)/documents/users/$(uid))
          || resource.data.status == 'active');
      allow list: if false;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'displayName', 'email', 'role', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'role', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'farmer'
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'updatedAt'])
        && validDisplayName(request.resource.data.displayName)
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
