rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function superadmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function activeAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function validDisplayName(value) {
      return value is string && value.size() > 0 && value.size() <= 120;
    }

    function validLocationText(value) {
      return value is string && value.size() > 0 && value.size() <= 100;
    }

    function validLocation(value) {
      return value is map
        && value.keys().hasAll(['region', 'district', 'community'])
        && value.keys().hasOnly(['region', 'district', 'community'])
        && validLocationText(value.region)
        && validLocationText(value.district)
        && validLocationText(value.community);
    }

    function activeFarmer() {
      let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(profilePath)
        && get(profilePath).data.role == 'farmer'
        && get(profilePath).data.status == 'active';
    }

    function validRole(value) {
      return value in ['farmer', 'expert', 'dataManager', 'admin', 'superadmin'];
    }

    function validProfile(data, uid) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'role', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'displayName', 'email', 'role', 'status', 'createdAt', 'updatedAt'
        ])
        && data.uid == uid
        && validDisplayName(data.displayName)
        && data.email is string
        && validRole(data.role)
        && data.status in ['active', 'inactive']
        && data.createdAt is timestamp
        && data.updatedAt == request.time;
    }

    function cropCategoryExists(categoryId) {
      return exists(/databases/$(database)/documents/cropCategories/$(categoryId));
    }

    function validCrop(data) {
      return data.keys().hasAll([
          'name', 'categoryId', 'source', 'reviewStatus', 'isPublic', 'status',
          'createdAt', 'updatedAt', 'updatedByUid'
        ])
        && data.keys().hasOnly([
          'name', 'categoryId', 'description', 'soilGuidance', 'plantingSeason',
          'waterGuidance', 'growthDuration', 'harvestPeriod', 'source', 'reviewStatus',
          'isPublic', 'status', 'createdAt', 'updatedAt', 'updatedByUid'
        ])
        && validDisplayName(data.name)
        && data.categoryId is string
        && data.categoryId.size() > 0
        && cropCategoryExists(data.categoryId)
        && data.source is string
        && data.source.size() > 0
        && data.reviewStatus in ['pending', 'approved', 'rejected']
        && data.isPublic is bool
        && data.status in ['active', 'inactive']
        && (!('description' in data) || data.description is string)
        && (!('soilGuidance' in data) || data.soilGuidance is string)
        && (!('plantingSeason' in data) || data.plantingSeason is string)
        && (!('waterGuidance' in data) || data.waterGuidance is string)
        && (!('growthDuration' in data) || data.growthDuration is string)
        && (!('harvestPeriod' in data) || data.harvestPeriod is string)
        && (!data.isPublic || (data.status == 'active' && data.reviewStatus == 'approved'));
    }

    function validCropCategory(data) {
      return data.keys().hasAll(['name', 'description', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['name', 'description', 'status', 'createdAt', 'updatedAt'])
        && validDisplayName(data.name)
        && data.description is string
        && data.status in ['active', 'inactive'];
    }

    match /users/{uid} {
      allow get: if signedIn()
        && (request.auth.uid == uid || superadmin());
      allow list: if superadmin();

      allow create: if validProfile(request.resource.data, uid)
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && (
          (
            signedIn()
            && request.auth.uid == uid
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.role == 'farmer'
          )
          || (
            superadmin()
            && request.auth.uid != uid
            && request.resource.data.role != 'farmer'
          )
        );

      allow update: if signedIn()
        && (
          (
            request.auth.uid == uid
            && resource.data.status == 'active'
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'location', 'updatedAt'])
            && validDisplayName(request.resource.data.displayName)
            && 'location' in request.resource.data
            && validLocation(request.resource.data.location)
            && request.resource.data.updatedAt == request.time
          )
          || (
            superadmin()
            && request.auth.uid != uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['role', 'status', 'updatedAt'])
            && validRole(request.resource.data.role)
            && request.resource.data.status in ['active', 'inactive']
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.updatedAt == request.time
          )
        );

      allow delete: if false;
    }

    match /farms/{farmId} {
      allow get, list: if activeFarmer()
        && resource.data.ownerUid == request.auth.uid;

      allow create: if activeFarmer()
        && request.resource.data.keys().hasAll([
          'ownerUid', 'name', 'location', 'size', 'sizeUnit', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'name', 'location', 'size', 'sizeUnit', 'cropIds', 'status', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && validDisplayName(request.resource.data.name)
        && validLocation(request.resource.data.location)
        && (request.resource.data.size is int || request.resource.data.size is float)
        && request.resource.data.size > 0
        && request.resource.data.sizeUnit in ['hectare', 'acre']
        && (!('cropIds' in request.resource.data) || request.resource.data.cropIds is list)
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if activeFarmer()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && validDisplayName(request.resource.data.name)
        && validLocation(request.resource.data.location)
        && (request.resource.data.size is int || request.resource.data.size is float)
        && request.resource.data.size > 0
        && request.resource.data.sizeUnit in ['hectare', 'acre']
        && (
          (
            resource.data.status == 'active'
            && request.resource.data.status in ['active', 'archived']
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'location', 'size', 'sizeUnit', 'cropIds', 'status', 'updatedAt'])
            && (!('cropIds' in request.resource.data) || request.resource.data.cropIds is list)
          )
          || (
            resource.data.status == 'archived'
            && request.resource.data.status == 'active'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt'])
          )
        );

      allow delete: if false;
    }

    match /crops/{cropId} {
      allow get, list: if activeAdmin()
        || (
          resource.data.isPublic == true
          && resource.data.status == 'active'
          && resource.data.reviewStatus == 'approved'
        );

      allow create: if activeAdmin()
        && validCrop(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;

      allow update: if activeAdmin()
        && validCrop(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'name', 'categoryId', 'description', 'soilGuidance', 'plantingSeason',
            'waterGuidance', 'growthDuration', 'harvestPeriod', 'source', 'reviewStatus',
            'isPublic', 'status', 'updatedAt', 'updatedByUid'
          ])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;

      allow delete: if false;
    }

    match /cropCategories/{categoryId} {
      allow get, list: if activeAdmin() || resource.data.status == 'active';

      allow create: if activeAdmin()
        && validCropCategory(request.resource.data)
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if activeAdmin()
        && validCropCategory(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'description', 'status', 'updatedAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
